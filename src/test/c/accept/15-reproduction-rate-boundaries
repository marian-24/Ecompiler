//reproductionRate en los limites exactos del rango valido [0.0, 1.0]

species Esteril = createSpecies {
    int lifespan = 12;
    float reproductionRate = 0.0;
    int speed = 4;
    reproductionStrategy = reproductionStrategy.K_SELECTED;
    diet = diet.HERBIVORE;
    habitat = habitat.TERRESTRIAL;
    environmentalTolerance;
    .temperature = [5, 35];
    .humidity = [30, 80];
    .altitude = [0, 4000];
}

species Prolifico = createSpecies {
    int lifespan = 6;
    float reproductionRate = 1.0;
    int speed = 9;
    reproductionStrategy = reproductionStrategy.R_SELECTED;
    diet = diet.HERBIVORE;
    habitat = habitat.TERRESTRIAL;
    environmentalTolerance;
    .temperature = [0, 40];
    .humidity = [20, 90];
    .altitude = [0, 5000];
}

region Bosque {
    temperature = 20;
    humidity = 70;
    altitude = 800;
    carryingCapacity = 200;
    habitat = TERRESTRIAL;
}

ecosystem Patagonia {
    region Bosque;
    species Esteril;
    species Prolifico;
}

add 10 Esteril to Patagonia.Bosque;
add 10 Prolifico to Patagonia.Bosque;
simulate Patagonia for 5 generations;
