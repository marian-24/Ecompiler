//Evento ambiental aleatorio con every random generations

region Bosque {
    temperature = 20;
    humidity = 70;
    altitude = 800;
    carryingCapacity = 200;
    habitat = TERRESTRIAL;
}

ecosystem Patagonia {
    region Bosque;
}

every random generations in Patagonia.Bosque {
    temperature += 2;
    humidity -= 1;
}

simulate Patagonia for 8 generations;
