//Un ecosistema con varias regiones y una especie repartida entre ellas

species Puma = createSpecies {
    int lifespan = 15;
    float reproductionRate = 0.4;
    int speed = 8;
    reproductionStrategy = reproductionStrategy.K_SELECTED;
    diet = diet.CARNIVORE;
    habitat = habitat.TERRESTRIAL;
    environmentalTolerance;
    .temperature = [5, 35];
    .humidity = [30, 80];
    .altitude = [0, 4000];
}

region Bosque {
    temperature = 20;
    humidity = 70;
    altitude = 800;
    carryingCapacity = 100;
    habitat = TERRESTRIAL;
}

region Pradera {
    temperature = 25;
    humidity = 50;
    altitude = 400;
    carryingCapacity = 150;
    habitat = TERRESTRIAL;
}

ecosystem Patagonia {
    region Bosque;
    region Pradera;
    species Puma;
}

add 10 Puma to Patagonia.Bosque;
add 5 Puma to Patagonia.Pradera;
simulate Patagonia for 5 generations;
